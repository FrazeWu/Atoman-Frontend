VITE_API_URL=/api
VITE_APP_VERSION=v0.2.0
# 默认开启统一搜索；仅在需要临时回退旧入口时设为 false。
VITE_UNIFIED_SEARCH_ENABLED=true
VITE_DEV_PROXY_ORIGIN=http://localhost:5173

# Copy to .env.dev for local development or .env.production for production builds.
# Leave Turnstile empty in development to hide the widget.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
